# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=Mabdel Backend API
ENVIRONMENT=development            # development | production
DEBUG=false
SECRET_KEY=change-this-to-a-long-random-string-in-production
# Base public backend URL used in generated share links.
# Examples:
# - Local development: http://127.0.0.1:8000
# - Public tunnel/test: https://your-current-ngrok-or-cloudflare-domain
# - Production: https://api.yourdomain.com
PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=mabdel_db

# ─── Authentication ───────────────────────────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=10
OAUTH_TOKEN_ENCRYPTION_KEY=          # 32-byte Fernet key (optional)

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini            # gpt-4o | gpt-4o-mini | gpt-4-turbo

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/oauth/callback

# DocuSign Agreements
DOCUSIGN_CLIENT_ID=
DOCUSIGN_CLIENT_SECRET=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_USER_ID=
DOCUSIGN_AUTH_SERVER=https://account-d.docusign.com
DOCUSIGN_REDIRECT_URI=http://127.0.0.1:8000/api/v1/smartflow/agreements/signature-providers/docusign/oauth/callback
DOCUSIGN_RETURN_URL=http://127.0.0.1:5173/documents
DOCUSIGN_CONNECT_SECRET=
DOCUSIGN_ENVIRONMENT=demo

# ─── Meta (Facebook / Instagram) OAuth ───────────────────────────────────────
META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/integrations/facebook/oauth/callback
META_INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/integrations/instagram/oauth/callback

# ─── LinkedIn OAuth ───────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/integrations/linkedin/oauth/callback

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ─── WhatsApp Business API ────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@mabdel.ai

# ─── Business email domains ───────────────────────────────────────────────────
# Owners claim "<business-slug>.<EMAIL_DOMAIN_ROOT>" and then send bulk email from
# any address on it; replies land in Unified Conversations.
# Leave EMAIL_DOMAIN_ROOT blank to disable auto-subdomains (custom domains still work).
EMAIL_DOMAIN_ROOT=
EMAIL_DOMAIN_DEFAULT_PREFIX=hello
EMAIL_DOMAIN_ALLOW_CUSTOM=true
# "route53" writes DNS for you (needs the AWS vars below + boto3 installed);
# "manual" shows the records in the UI for the owner to add.
EMAIL_DOMAIN_DNS_PROVIDER=manual
ROUTE53_HOSTED_ZONE_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Signing secret of the Resend webhook pointed at
# POST /api/v1/dashboard/webhooks/resend/inbound  (starts with whsec_)
RESEND_INBOUND_WEBHOOK_SECRET=
# Leave blank normally: Resend returns the receiving MX in the domain records once
# "Receiving" is toggled on. Set it only to force an extra MX row (priority 10),
# e.g. so Route53 auto-provisioning can write it for you. Copy the exact value
# from resend.com/domains -> your domain -> Receiving.
RESEND_INBOUND_MX_HOST=

# ─── File Storage ─────────────────────────────────────────────────────────────
MEDIA_ROOT=uploads
MEDIA_MAX_UPLOAD_BYTES=5242880      # 5 MB
